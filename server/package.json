  "dependencies": {
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "ioredis": "^4.30.1",
    "ioredis-mock": "^4.21.8",
    "mongodb": "^6.20.0",
    "pino": "^9.9.5",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1"
  }
