{
  "folderTemplates.structures": [
    {
      "name": "Custom Component",
      "omitParentDirectory": false,
      "structure": [
        {
          "fileName": "<FTName | pascalcase>.jsx",
          "template": "CustomComponentJSX"
        },
        {
          "fileName": "<FTName | pascalcase>.module.css",
          "template": "CustomComponentCSS"
        },
        {
          "fileName": "index.js",
          "template": "CustomComponentIndex"
        }
      ]
    },
    {
      "name": "Custom Page",
      "omitParentDirectory": false,
      "structure": [
        {
          "fileName": "<FTName | pascalcase>.jsx",
          "template": "CustomPageJSX"
        },
        {
          "fileName": "<FTName | pascalcase>.module.css",
          "template": "CustomPageCSS"
        },
        {
          "fileName": "index.js",
          "template": "CustomPageIndex"
        }
      ]
    }
  ],
  "folderTemplates.fileTemplates": {
    "CustomComponentJSX": [
      "import React from 'react';",
      "import styles from './<FTName | pascalcase>.module.css';",
      "",
      "export default function <FTName | pascalcase>() {",
      "  return (",
      "    <div className={styles.<FTName | camelcase>}>",
      "      This is the <FTName | pascalcase> component.",
      "    </div>",
      "  );",
      "}"
    ],
    "CustomComponentCSS": [
      ".<FTName | camelcase> {",
      "  font-size: 16px;",
      "  color: #333;",
      "}"
    ],
    "CustomComponentIndex": [
      "export { default } from './<FTName | pascalcase>';"
    ],
    "CustomPageJSX": [
      "import React from 'react';",
      "import styles from './<FTName | pascalcase>.module.css';",
      "",
      "export default function <FTName | pascalcase>() {",
      "  return (",
      "    <main className={styles.<FTName | camelcase>}>",
      "      <h1><FTName | pascalcase> Page</h1>",
      "      <p>This is a full-page component intended for routing.</p>",
      "    </main>",
      "  );",
      "}"
    ],
    "CustomPageCSS": [
      ".<FTName | camelcase> {",
      "  display: flex;",
      "  flex-direction: column;",
      "  justify-content: center;",
      "  align-items: center;",
      "  height: 100vh;",
      "  width: 100%;",
      "}"
    ],
    "CustomPageIndex": ["export { default } from './<FTName | pascalcase>';"]
  },
  "folderTemplates.templateNotation": {
    "start": ["<", "["],
    "end": [">", "]"]
  }
}
