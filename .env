
# Server Ports
HTTPS_PORT=5000
HTTP_PORT=8080

# SSL Certificate Paths
SSL_PATH=server/certs
CERT_KEY=server.key
CERT_CRT=server.crt

# CORS
CORS_ORIGIN=https://localhost:5173

# Node Environment
NODE_ENV=development

# Session Details
SESSION_SECRET=some_long_random_secret_here

# Use Redis Mock (true/false)
USE_REDIS_MOCK=true
